{
  "name": "endless-arcane-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
